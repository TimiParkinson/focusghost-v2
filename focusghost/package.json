{
  "name": "focusghost",
  "productName": "FocusGhost",
  "version": "0.1.0",
  "description": "Desktop AI focus companion - Electron + Svelte + Gemini",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:demo": "electron-vite dev -- --demo",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --ext .ts,.svelte .",
    "package": "yarn build && electron-builder --dir",
    "make": "yarn build && electron-builder",
    "make:mac": "yarn build && electron-builder --mac",
    "make:win": "yarn build && electron-builder --win",
    "make:linux": "yarn build && electron-builder --linux"
  },
  "keywords": ["electron", "focus", "productivity", "ai", "svelte"],
  "author": "FocusGhost Team",
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.4.17",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-svelte": "^2.45.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^5.1.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "active-win": "^8.2.0",
    "dotenv": "^17.4.2",
    "electron-store": "^8.2.0",
    "gsap": "^3.12.5",
    "lucide-svelte": "^0.460.0"
  }
}
